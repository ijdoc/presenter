{
  "manifest_version": 3,
  "name": "presenter",
  "version": "1.2.2",
  "description": "Pointer and fading highlights for live demos, plus toggleable UX enhancements for before/after clips.",
  "key": "",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "icons": {
    "16": "presenter16.png",
    "48": "presenter48.png",
    "128": "presenter128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "presenter16.png",
      "48": "presenter48.png",
      "128": "presenter128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "commands": {
    "toggle-proposed": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Flip between the shipped page and the proposed one"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.wandb.ai/*",
        "https://forge.coreweave.com/*",
        "https://*.github.com/*",
        "http://workhorse:8888/*",
        "http://localhost:8080/*"
      ],
      "exclude_globs": [
        "https://wandb.ai/site",
        "https://wandb.ai/site/*"
      ],
      "js": [
        "src/content/loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/*",
        "src/lib/*",
        "enhancements/*"
      ],
      "matches": [
        "https://*.wandb.ai/*",
        "https://forge.coreweave.com/*",
        "https://*.github.com/*",
        "http://workhorse:8888/*",
        "http://localhost:8080/*"
      ]
    }
  ]
}
